$$
DELIMITER ;$$


#
# Type cast from other data types
#

DELIMITER $$;
--error ER_UNKNOWN_OPERATOR
BEGIN NOT ATOMIC
  DECLARE a INT;
  SELECT CAST(a AS SYS_REFCURSOR);
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNKNOWN_OPERATOR
BEGIN NOT ATOMIC
  DECLARE a DOUBLE;
  SELECT CAST(a AS SYS_REFCURSOR);
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNKNOWN_OPERATOR
BEGIN NOT ATOMIC
  DECLARE a FLOAT;
  SELECT CAST(a AS SYS_REFCURSOR);
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNKNOWN_OPERATOR
BEGIN NOT ATOMIC
  DECLARE a DECIMAL;
  SELECT CAST(a AS SYS_REFCURSOR);
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNKNOWN_OPERATOR
BEGIN NOT ATOMIC
  DECLARE a CHAR(30);
  SELECT CAST(a AS SYS_REFCURSOR);
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNKNOWN_OPERATOR
BEGIN NOT ATOMIC
  DECLARE a TIME;
  SELECT CAST(a AS SYS_REFCURSOR);
END;
$$
DELIMITER ;$$

DELIMITER $$;
--error ER_UNKNOWN_OPERATOR
